#!/bin/sh
# Deploy to GAE with a custom version ID encoding the current git state.
#
# GAE auto-exposes the version ID at runtime via $GAE_VERSION, so the
# health page can display "what's actually running" without shipping any
# extra files. Format: <tag>-<short-sha>-<clean|dirty>, with the tag's
# dots mangled to hyphens since GAE version IDs are restricted to
# lowercase alphanumerics + hyphens.
#
# Bare `gcloud app deploy app.yaml` still works but assigns a timestamp
# version ID — the health page shows that raw, which is itself a clear
# "this wasn't deployed via bin/deploy" signal.
#
# Pass --refresh to run `bin/refresh` once the deploy lands, forcing the
# event snapshot to be rebuilt instead of waiting for the 6am cron. Any
# other arguments are handed through to `gcloud app deploy` — except
# --help, which describes this wrapper rather than the command it wraps.

set -e
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
cd "$(dirname "$0")/.."

usage() {
    cat <<'EOF'
Usage: bin/deploy [--refresh] [gcloud app deploy flags...]

Deploys app.yaml to App Engine with a version ID encoding the current git
state — <tag>-<short-sha>[-dirty] — so the health page can report what is
actually running. A bare `gcloud app deploy` takes a timestamp ID instead,
which is itself a signal that this wrapper wasn't used.

  --refresh     rebuild the event snapshot after a successful deploy,
                rather than waiting for the 6am cron. Runs bin/refresh,
                which writes the real production blob from your machine.
  --help, -h    this text

Anything else is passed through untouched; for those flags see
`gcloud app deploy --help`.
EOF
}

# Checked before anything is consumed or handed on: reaching for --help and
# getting gcloud's manual instead of this one is a small betrayal, and the
# thing you wanted to be reminded of is usually --refresh.
for arg in "$@"; do
    case "$arg" in
        --help | -h)
            usage
            exit 0
            ;;
    esac
done

# Pull --refresh out of the argument list, leaving the rest for gcloud.
# Rotating through "$@" rather than rebuilding a string keeps any argument
# that contains spaces intact.
REFRESH=0
remaining=$#
while [ "$remaining" -gt 0 ]; do
    arg="$1"
    shift
    if [ "$arg" = "--refresh" ]; then
        REFRESH=1
    else
        set -- "$@" "$arg"
    fi
    remaining=$((remaining - 1))
done

TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo v0)
SHA=$(git rev-parse --short HEAD)
SAFE_TAG=$(echo "$TAG" | tr '.' '-')
ID="${SAFE_TAG}-${SHA}"
if git status --porcelain | grep -q .; then
    ID="${ID}-dirty"
fi

echo "Deploying as version: ${ID}"
gcloud app deploy app.yaml --version="$ID" "$@"

# Only after a successful deploy — the snapshot this writes can carry
# fields the previously-deployed code wouldn't understand.
if [ "$REFRESH" -eq 1 ]; then
    echo
    exec "${SCRIPT_DIR}/refresh"
fi
